  }
  .categories-scroll::-webkit-scrollbar {
    display: none;
  }
  
  /* Modern Glassmorphic Pill Design */
  .category-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text, #222222);
    font-size: 0.84rem;
    font-weight: 600;
    white-space: nowrap;
    padding: 0.55rem 1.1rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04), inset 0 1px 1px rgba(255, 255, 255, 0.8);
    transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
    cursor: pointer;
  }
  
  .category-pill:hover {
    color: #ba0036;
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(255, 56, 92, 0.4);
    box-shadow: 0 6px 20px rgba(255, 56, 92, 0.15), inset 0 1px 1px rgba(255, 255, 255, 0.9);
    transform: translateY(-2px);
  }
  
  .category-pill.active {
    color: #ffffff;
    background: linear-gradient(135deg, #ff385c 0%, #e00b41 100%);
    border-color: #ba0036;
    box-shadow: 0 6px 18px rgba(255, 56, 92, 0.35), inset 0 1px 2px rgba(255, 255, 255, 0.4);
    transform: translateY(-1px);
  }
  
  .cat-emoji {
    font-size: 1.15rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    transition: transform 0.2s ease;
  }
  .category-pill:hover .cat-emoji {
    transform: scale(1.15);
  }
  
