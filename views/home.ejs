<% layout('layouts/boilerplate') -%>

  <% var pageClass='page-main--home' ; %>

<section class="hero hero--clean" style="background: #ffffff; padding: 2.25rem 1rem 2rem; text-align: center; border-bottom: 1px solid #ebebeb;">
  <div class="container-xl" style="max-width: 950px; margin: 0 auto;">
    <h1 class="hero-title" style="font-size: 2.5rem; font-weight: 800; color: var(--text, #222); margin-bottom: 0.75rem; letter-spacing: -0.5px;">
      Find Your Next Escape
    </h1>
    <p class="hero-sub" style="font-size: 1.1rem; color: var(--text-muted, #717171); margin-bottom: 2rem; max-width: 680px; margin-left: auto; margin-right: auto;">
      Discover cabins, luxury lodges, villas, and one-of-a-kind stays curated for unforgettable journeys worldwide.
    </p>

    <!-- Centered Search Bar -->
    <div style="display: flex; justify-content: center;">
      <form class="hero-glass-pill hero-search" action="/listings" method="get" style="box-shadow: 0 4px 20px rgba(0,0,0,0.08); background: #ffffff; border: 1px solid var(--border, #ddd); border-radius: 9999px; padding: 0.5rem 0.8rem 0.5rem 1.5rem; display: inline-flex; align-items: center; gap: 0.5rem; max-width: 100%; flex-wrap: wrap;">
        <div class="hs-field" style="text-align: left; padding: 0.25rem 0.5rem;">
          <label for="hero-where" style="display: block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted, #717171);">Where</label>
          <input id="hero-where" type="text" name="search" placeholder="Search destinations" style="border: none; outline: none; background: transparent; font-weight: 600; font-size: 0.9rem; color: var(--text, #222); width: 160px;" />
        </div>
        <div class="hs-divider" style="width: 1px; height: 28px; background: var(--border-soft, #eaeaea);"></div>
        <div class="hs-field" style="text-align: left; padding: 0.25rem 0.5rem;">
          <label for="hero-checkin" style="display: block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted, #717171);">Check in</label>
          <input id="hero-checkin" type="date" name="checkin" style="border: none; outline: none; background: transparent; font-weight: 500; font-size: 0.85rem; color: var(--text, #222);" />
        </div>
        <div class="hs-divider" style="width: 1px; height: 28px; background: var(--border-soft, #eaeaea);"></div>
        <div class="hs-field" style="text-align: left; padding: 0.25rem 0.5rem;">
          <label for="hero-checkout" style="display: block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted, #717171);">Check out</label>
          <input id="hero-checkout" type="date" name="checkout" style="border: none; outline: none; background: transparent; font-weight: 500; font-size: 0.85rem; color: var(--text, #222);" />
        </div>
        <div class="hs-divider" style="width: 1px; height: 28px; background: var(--border-soft, #eaeaea);"></div>
        <div class="hs-field" style="text-align: left; padding: 0.25rem 0.5rem;">
          <label for="hero-guests" style="display: block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted, #717171);">Guests</label>
          <input id="hero-guests" type="number" name="guests" min="1" max="16" value="2" style="border: none; outline: none; background: transparent; font-weight: 600; font-size: 0.9rem; color: var(--text, #222); width: 60px;" />
        </div>
        <button class="hs-submit" type="submit" aria-label="Search" style="width: 44px; height: 44px; border-radius: 50%; background: #ff385c; color: white; border: none; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: transform 0.15s ease, background 0.15s ease;">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>
    </div>
  </div>
</section>

      <section class="container-xl pt-4">
        <%- include('includes/categories') %>
      </section>

      <% if (typeof beachListings !=='undefined' && beachListings && beachListings.length> 0) { %>
        <section class="container-xl pt-4">
          <div class="section-row">
            <div>
              <h2 class="section-title"><span class="me-2">🏖️</span>Beachfront Escapes</h2>
              <p>Sunny coastal cottages, ocean villas, and tropical paradises.</p>
            </div>
            <a class="link-arrow" href="/listings?category=beach">Explore beachfront <i class="fa-solid fa-arrow-right"></i></a>
          </div>

          <div class="skiper-scroll-wrapper">
            <button class="skiper-arrow skiper-prev is-hidden" type="button" aria-label="Previous beachfront stays">
              <i class="fa-solid fa-chevron-left"></i>
            </button>
            <div class="skiper-scroll" data-skiper-scroll>
              <% beachListings.forEach((listing)=> { %>
                <div class="listing-card">
                  <a href="/listings/<%= listing._id %>" class="card-link">
                    <div class="card-media">
                      <img
                        src="<%= listing.image && listing.image.url ? listing.image.url : (typeof listing.image === 'string' && listing.image ? listing.image : 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=800&q=60') %>"
                        alt="<%= listing.title %>" loading="lazy" />
                      <span class="card-badge">🏖️ Beachfront</span>
                    </div>
                    <div class="card-body">
                      <div class="card-row">
                        <h3 class="card-title">
                          <%= listing.location %>, <%= listing.country %>
                        </h3>
                        <% if (listing._avgRating) { %>
                          <span class="card-rating"><i class="fa-solid fa-star"></i>
                            <%= listing._avgRating.toFixed(1) %>
                          </span>
                          <% } else { %>
                            <span class="card-rating card-rating--new">New</span>
                            <% } %>
                      </div>
                      <p class="card-subtitle">
                        <%= listing.title %>
                      </p>
                      <p class="card-price">
                        &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %> <span>/ night</span>
                      </p>
                    </div>
                  </a>
                  <% if (typeof currentUser !=='undefined' && currentUser) { %>
                    <form method="post" action="/wishlist/<%= listing._id %>/toggle" class="wishlist-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="wishlist-btn" aria-label="Save to wishlist">
                        <i class="fa-regular fa-heart"></i>
                      </button>
                    </form>
                    <% } %>
                </div>
                <% }); %>
            </div>
            <button class="skiper-arrow skiper-next" type="button" aria-label="Next beachfront stays">
              <i class="fa-solid fa-chevron-right"></i>
            </button>
          </div>
        </section>
        <% } %>

