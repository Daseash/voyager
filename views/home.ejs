                                            <a href="/listings/<%= listing._id %>" class="card-link">
                                              <div class="card-media">
                                                <img
                                                  src="<%= listing.image && listing.image.url ? listing.image.url : (typeof listing.image === 'string' && listing.image ? listing.image : 'https://images.unsplash.com/photo-1585543805890-6051f7829f98?auto=format&fit=crop&w=800&q=60') %>"
                                                  alt="<%= listing.title %>" loading="lazy" />
                                                <span class="card-badge">🏰 Castle</span>
                                              </div>
                                              <div class="card-body">
                                                <div class="card-row">
                                                  <h3 class="card-title">
                                                    <%= listing.location %>, <%= listing.country %>
                                                  </h3>
                                                  <% if (listing._avgRating) { %>
                                                    <span class="card-rating"><i class="fa-solid fa-star"></i>
                                                      <%= listing._avgRating.toFixed(1) %>
                                                    </span>
                                                    <% } else { %>
                                                      <span class="card-rating card-rating--new">New</span>
                                                      <% } %>
                                                </div>
                                                <p class="card-subtitle">
                                                  <%= listing.title %>
                                                </p>
                                                <p class="card-price">
                                                  &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : '0'
                                                    %> <span>/ night</span>
                                                </p>
                                              </div>
                                            </a>
                                            <% if (typeof currentUser !=='undefined' && currentUser) { %>
                                              <form method="post" action="/wishlist/<%= listing._id %>/toggle"
                                                class="wishlist-form">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                                <button type="submit" class="wishlist-btn"
                                                  aria-label="Save to wishlist">
                                                  <i class="fa-regular fa-heart"></i>
                                                </button>
                                              </form>
                                              <% } %>
                                          </div>
                                          <% }); %>
                                      </div>
                                    </section>
                                    <% } %>

                                      <% if (typeof featuredListings !=='undefined' && featuredListings &&
                                        featuredListings.length> 0) { %>
                                        <section class="container-xl pt-5">
                                          <div class="section-row">
                                            <div>
                                              <h2 class="section-title"><span class="me-2">⭐</span>All Stays on WanderLust</h2>
                                              <p>Handpicked stays loved by guests worldwide.</p>
                                            </div>
                                            <a class="link-arrow" href="/listings">Show all stays <i
                                                class="fa-solid fa-arrow-right"></i></a>
                                          </div>

                                          <div class="listing-grid">
                                            <% featuredListings.forEach((listing)=> { %>
                                              <div class="listing-card">
                                                <a href="/listings/<%= listing._id %>" class="card-link">
                                                  <div class="card-media">
                                                    <img
                                                      src="<%= listing.image && listing.image.url ? listing.image.url : (typeof listing.image === 'string' && listing.image ? listing.image : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=60') %>"
                                                      alt="<%= listing.title %>" loading="lazy" />
                                                    <span class="card-badge">⭐ Featured</span>
                                                  </div>
                                                  <div class="card-body">
                                                    <div class="card-row">
                                                      <h3 class="card-title">
                                                        <%= listing.location %>, <%= listing.country %>
                                                      </h3>
                                                      <% if (listing._avgRating) { %>
                                                        <span class="card-rating"><i class="fa-solid fa-star"></i>
                                                          <%= listing._avgRating.toFixed(1) %>
                                                        </span>
                                                        <% } %>
                                                    </div>
                                                    <p class="card-subtitle">
                                                      <%= listing.title %>
                                                    </p>
                                                    <p class="card-price">
                                                      &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN")
                                                        : '0' %> <span>/ night</span>
                                                    </p>
                                                  </div>
                                                </a>
                                                <% if (typeof currentUser !=='undefined' && currentUser) { %>
                                                  <form method="post" action="/wishlist/<%= listing._id %>/toggle"
                                                    class="wishlist-form">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                                    <button type="submit" class="wishlist-btn"
                                                      aria-label="Save to wishlist">
                                                      <i class="fa-regular fa-heart"></i>
                                                    </button>
                                                  </form>
                                                  <% } %>
                                              </div>
                                              <% }); %>
                                          </div>
                                        </section>
                                        <% } %>

                                          <% if (!featuredListings || featuredListings.length===0) { %>
                                            <section class="container-xl py-5">
                                              <div class="empty-state">
                                                <i class="fa-solid fa-compass"></i>
                                                <h3>The adventure starts here</h3>
                                                <p>Be the first to publish a new stay on WanderLust.</p>
                                                <a href="/listings/new" class="btn btn-accent btn-lg">
                                                  <i class="fa-solid fa-plus me-1"></i> Add New Stay
                                                </a>
                                              </div>
                                            </section>
                                            <% } %>

                                              <section class="promo-band">
                                                <div class="container-xl promo-band-inner">
                                                  <div class="promo-copy">
                                                    <span class="promo-eyebrow">Become a host</span>
                                                    <h2 class="promo-title">It&rsquo;s easy to start hosting and earn
                                                      extra income</h2>
                                                    <p class="promo-text">
                                                      List your place on WanderLust — set your own price, share your
                                                      space, and welcome
                                                      guests from around the world.
                                                    </p>
                                                    <a href="/listings/new" class="btn btn-accent btn-lg">
                                                      <i class="fa-solid fa-house-circle-check me-1"></i> Start hosting
                                                    </a>
                                                  </div>
                                                  <div class="promo-art" aria-hidden="true">
                                                    <div class="promo-art-card promo-art-card--1"><i
                                                        class="fa-solid fa-key"></i></div>
                                                    <div class="promo-art-card promo-art-card--2"><i
                                                        class="fa-solid fa-hand-holding-dollar"></i></div>
                                                    <div class="promo-art-card promo-art-card--3"><i
                                                        class="fa-solid fa-map-location-dot"></i></div>
                                                  </div>
                                                </div>
                                              </section>

                                              <section class="container-xl trust-band">
                                                <div class="trust-header">
                                                  <span class="promo-eyebrow">WanderLust Cover</span>
                                                  <h2 class="section-title">Every booking includes free protection</h2>
                                                  <p>Your trip is protected from Host cancellations, listing
                                                    inaccuracies, and more.</p>
                                                </div>
                                                <div class="trust-grid">
                                                  <div class="trust-item">
                                                    <i class="fa-solid fa-shield-halved"></i>
                                                    <h4>Booking Protection Guarantee</h4>
                                                    <p>If a Host cancels on you, find a similar or better home, or
                                                      we&rsquo;ll refund you.</p>
                                                  </div>
                                                  <div class="trust-item">
                                                    <i class="fa-solid fa-check-double"></i>
                                                    <h4>Get-What-You-Booked Guarantee</h4>
                                                    <p>If your stay isn&rsquo;t what you booked, we&rsquo;ll find a
                                                      similar home or refund you.</p>
                                                  </div>
                                                  <div class="trust-item">
                                                    <i class="fa-solid fa-headset"></i>
                                                    <h4>24-hour Safety Line</h4>
                                                    <p>Priority access to specially-trained safety agents, any time, day
                                                      or night.</p>
                                                  </div>
                                                  <div class="trust-item">
                                                    <i class="fa-solid fa-circle-exclamation"></i>
                                                    <h4>Guest Support</h4>
                                                    <p>Fast, friendly, round-the-clock help whenever you need it —
                                                      before and during your trip.</p>
                                                  </div>
                                                </div>
                                              </section>